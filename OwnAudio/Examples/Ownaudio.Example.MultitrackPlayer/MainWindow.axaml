<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MultitrackPlayer.ViewModels"
        xmlns:vst="using:OwnaudioNET.Effects.VST"
        mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="720"
        x:Class="MultitrackPlayer.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OwnAudio Multitrack Player"
        Width="1150" Height="720"
        MinWidth="1000" MinHeight="560"
        Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#3E3E42" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ProgressBar.meter">
            <Setter Property="Minimum" Value="-60" />
            <Setter Property="Maximum" Value="0" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="#4EC9B0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Transport -->
        <Border Grid.Row="0" Background="#252526" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Add Tracks" Click="OnAddTracksClicked" Background="#0E639C" />
                <Button Content="Play" Command="{Binding PlayCommand}" Background="#0E7A0D" />
                <Button Content="Pause" Command="{Binding PauseCommand}" Background="#9A7D0A" />
                <Button Content="Stop" Command="{Binding StopCommand}" Background="#A1260D" />
            </StackPanel>
        </Border>

        <!-- Timeline -->
        <Border Grid.Row="1" Background="#252526" Padding="10,0,10,10">
            <Grid ColumnDefinitions="*,Auto">
                <Slider Name="SeekSlider"
                        Minimum="0"
                        Maximum="{Binding TrackDurationSeconds}"
                        Value="{Binding CurrentPositionSeconds, Mode=OneWay}"
                        Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding PositionDisplay}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*,2*">

            <!-- Tracks -->
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="title" Text="Tracks" Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackViewModel">
                                    <Border Classes="card" Margin="0,0,0,5">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Text="{Binding FileName}" Foreground="White"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <Slider Grid.Column="1" Value="{Binding Volume}"
                                                    Minimum="0" Maximum="100" Width="110"
                                                    VerticalAlignment="Center" Margin="10,0,5,0" />

                                            <TextBlock Grid.Column="2" Classes="label" Width="40"
                                                       Text="{Binding Volume, StringFormat='{}{0:F0}%'}" />

                                            <ToggleButton Grid.Column="3" Content="M" IsChecked="{Binding IsMuted}"
                                                          Margin="5,0,2,0" ToolTip.Tip="Mute" />

                                            <ToggleButton Grid.Column="4" Content="S" IsChecked="{Binding IsSolo}"
                                                          Margin="2,0,8,0" ToolTip.Tip="Solo" />

                                            <Button Grid.Column="5" Content="×" Background="#A1260D"
                                                    Padding="10,4" ToolTip.Tip="Remove track"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveTrackCommand}"
                                                    CommandParameter="{Binding}" />

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Spacing="2" Margin="0,8,0,0">
                                                <ProgressBar Classes="meter" Value="{Binding LeftLevel}" />
                                                <ProgressBar Classes="meter" Value="{Binding RightLevel}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Master -->
            <Border Grid.Column="1" Classes="panel">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="title" Text="Master" />
                            <Button Grid.Column="1" Content="Reset" Background="#555555"
                                    Command="{Binding ResetControlsCommand}"
                                    ToolTip.Tip="Volume 100%, tempo 100%, pitch 0" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Volume" />
                                <TextBlock Grid.Column="1" Classes="label"
                                           Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}" />
                            </Grid>
                            <Slider Value="{Binding MasterVolume}" Minimum="0" Maximum="100" />
                            <ProgressBar Classes="meter" Value="{Binding MasterLeftLevel}" />
                            <ProgressBar Classes="meter" Value="{Binding MasterRightLevel}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Tempo" />
                                <TextBlock Grid.Column="1" Classes="label"
                                           Text="{Binding TempoPercent, StringFormat='{}{0:F0}%'}" />
                            </Grid>
                            <Slider Value="{Binding TempoPercent}"
                                    Minimum="{Binding MinTempoPercent}" Maximum="{Binding MaxTempoPercent}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="label" Text="Pitch" />
                                <TextBlock Grid.Column="1" Classes="label"
                                           Text="{Binding PitchSemitones, StringFormat='{}{0:+0;-0;0} st'}" />
                            </Grid>
                            <Slider Value="{Binding PitchSemitones}" Minimum="-12" Maximum="12"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>

                        <!-- Master plugin -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Plugin" FontWeight="Bold" Foreground="#4EC9B0"
                                               VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPluginEnabled}"
                                                  OnContent="On" OffContent="Bypass" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <ComboBox ItemsSource="{Binding AvailablePlugins}"
                                              SelectedItem="{Binding SelectedPlugin}"
                                              HorizontalAlignment="Stretch" Margin="0,0,5,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vst:AudioPluginInfo">
                                                <TextBlock>
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text="{Binding Format}" Foreground="#888888" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Load" Background="#0E639C"
                                            Command="{Binding LoadPluginCommand}" Margin="0,0,5,0" />
                                    <Button Grid.Column="2" Content="Rescan" Background="#555555"
                                            Command="{Binding ScanPluginsCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding PluginName}" Foreground="#CCCCCC"
                                           FontSize="11" FontStyle="Italic" />

                                <Grid ColumnDefinitions="*,*">
                                    <Button Content="Editor" Background="#0E7A0D" HorizontalAlignment="Stretch"
                                            Command="{Binding OpenPluginEditorCommand}" Margin="0,0,5,0" />
                                    <Button Grid.Column="1" Content="Remove" Background="#A1260D"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding RemovePluginCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Smart Master -->
            <Border Grid.Column="2" Classes="panel">
                <Border Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Smart Master" FontWeight="Bold" Foreground="#4EC9B0"
                                       VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSmartMasterEnabled}"
                                          OnContent="On" OffContent="Off" />
                        </Grid>

                        <StackPanel Spacing="4" IsEnabled="{Binding IsSmartMasterEnabled}">
                            <TextBlock Classes="label" Text="Speaker preset" FontSize="11" />
                            <ComboBox ItemsSource="{Binding SpeakerPresets}"
                                      SelectedItem="{Binding SelectedSpeakerPreset}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" IsEnabled="{Binding IsSmartMasterEnabled}">
                            <Button Content="Save..." Background="#555555" HorizontalAlignment="Stretch"
                                    Click="OnSaveSmartMasterClicked" Margin="0,0,5,0" />
                            <Button Grid.Column="1" Content="Load..." Background="#555555"
                                    HorizontalAlignment="Stretch" Click="OnLoadSmartMasterClicked" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Status -->
        <Border Grid.Row="3" Background="#252526" Padding="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="label" Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding EngineLoadText}" Margin="0,0,20,0" />
                <TextBlock Grid.Column="2" Classes="label"
                           Text="{Binding Tracks.Count, StringFormat='Tracks: {0}'}" />
            </Grid>
        </Border>
    </Grid>
</Window>

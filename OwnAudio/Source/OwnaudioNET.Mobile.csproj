<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildMobile)' == 'true'">net10.0-android;net10.0-ios</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;Mt3\bin\**;Mt3\obj\**</DefaultItemExcludes>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.StartsWith('net10.0-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.StartsWith('net10.0-ios'))">12.2</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild Condition="'$(BuildMobile)' == 'true'">true</GeneratePackageOnBuild>
    <GeneratePackageOnBuild Condition="'$(BuildMobile)' != 'true'">false</GeneratePackageOnBuild>
    <PackageOutputPath>..\..\artifacts\local-packages\</PackageOutputPath>
    <PackageId>OwnAudioSharp.Mobile</PackageId>
    <Version>4.0.9</Version>
    <Authors>ModernMube</Authors>
    <Description>Cross-platform audio engine for .NET mobile apps (Android, iOS), built on a native Rust core. Playback, recording, multi-track mixing, effects, VST3 hosting, matchering and MIDI (ports, files, clock), without the ONNX-based analysis features (no chord detection, no note transcription). No UI framework dependency and no visual controls, so it works with any UI stack. AOT-compatible and trimmable.</Description>
    <PackageTags>audio;cross-platform;android;ios;mobile;sound;multitrack</PackageTags>
    <RepositoryUrl>https://github.com/ModernMube/OwnAudioSharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageCopyright>Copyright (c) 2025 ModernMube</PackageCopyright>
    <PackageIcon>ownaudio.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.303" PrivateAssets="All" />
    <PackageReference Include="OwnAudioVst" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Features\ChorDetect\**\*.cs" />
    <Compile Remove="Features\Extensions\**\*.cs" />
    <Compile Remove="Mt3\**\*.cs" />
    <Compile Remove="Visualization\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="basesample.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ownaudio.png" Pack="true" PackagePath="\" />
    <None Include="README.Mobile.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OwnAudioEngine\Ownaudio.Core\Ownaudio.Core.csproj" PrivateAssets="all" IncludeAssets="runtime" />
    <ProjectReference Include="..\..\OwnAudioEngine\OwnAudioRust\OwnAudioRust.csproj" PrivateAssets="all" IncludeAssets="runtime" />
    <!-- MIDI ships inside this package: on iOS its exports live in libownaudio_ffi.a, a second
         static archive would bring a second Rust std. The project packs on its own too, not here. -->
    <ProjectReference Include="..\Midi\OwnAudio.Midi.csproj" PrivateAssets="all" IncludeAssets="runtime"
                      AdditionalProperties="GeneratePackageOnBuild=false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_PackEngineAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="_PackEngineAssemblies" DependsOnTargets="ResolveReferences">
    <Error Condition="!$(TargetFramework.Contains('-android')) AND !$(TargetFramework.Contains('-ios'))"
           Text="OwnAudioSharp.Mobile is being packed for $(TargetFramework), which is not a mobile target framework. The resulting package would install on Android and iOS and then fail at run time. Pack with -p:BuildMobile=true." />

    <ItemGroup>
      <_EngineAssembly Include="@(ReferenceCopyLocalPaths)"
                       Condition="'%(Extension)' == '.dll' AND ('%(Filename)' == 'Ownaudio.Core' OR '%(Filename)' == 'OwnAudioRust' OR '%(Filename)' == 'OwnAudio.Midi')" />
      <BuildOutputInPackage Include="@(_EngineAssembly)" />
    </ItemGroup>

    <Error Condition="'@(_EngineAssembly->Count())' != '3'"
           Text="OwnAudioSharp.Mobile would ship without its engine assemblies for $(TargetFramework): expected Ownaudio.Core.dll, OwnAudioRust.dll and OwnAudio.Midi.dll among the resolved references, found '@(_EngineAssembly->'%(Filename)')'. Pack with -p:BuildMobile=true so all three projects expose their mobile target framework." />
  </Target>

  <ItemGroup>
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\android-arm\**\*.*" Pack="true" PackagePath="runtimes\android-arm" />
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\android-arm64\**\*.*" Pack="true" PackagePath="runtimes\android-arm64" />
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\android-x64\**\*.*" Pack="true" PackagePath="runtimes\android-x64" />
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\ios-arm64\**\*.*" Pack="true" PackagePath="runtimes\ios-arm64" />
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\iossimulator-arm64\**\*.*" Pack="true" PackagePath="runtimes\iossimulator-arm64" />
    <None Include="..\..\OwnAudioEngine\OwnAudioRust\runtimes\iossimulator-x64\**\*.*" Pack="true" PackagePath="runtimes\iossimulator-x64" />
    <!-- Android keeps MIDI in its own shared library, next to the audio one. -->
    <None Include="..\Midi\runtimes\android-arm\**\*.*" Pack="true" PackagePath="runtimes\android-arm" />
    <None Include="..\Midi\runtimes\android-arm64\**\*.*" Pack="true" PackagePath="runtimes\android-arm64" />
    <None Include="..\Midi\runtimes\android-x64\**\*.*" Pack="true" PackagePath="runtimes\android-x64" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\OwnAudioSharp.Mobile.targets" Pack="true" PackagePath="buildTransitive\net10.0-ios18.0\OwnAudioSharp.Mobile.targets" />
  </ItemGroup>

</Project>
